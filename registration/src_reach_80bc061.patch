+            means = [_mean(per[str(p)][g][est] for g in sets) for p in POPS]
+            vals["H16-2"][est] = _slope(POPS, means)
+        sl["H16-1"] = dict(members={str(p): dict(welch=({g: per[str(p)][g]["primary"] for g in boolean},
+                                                        {g: per[str(p)][g]["primary"] for g in real}))
