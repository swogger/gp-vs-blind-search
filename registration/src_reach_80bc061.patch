+"""The node-count baseline's ranking quality on the held-out records (descriptive; D117; REQ-ANA-104).
+
+The registered H7 scoring (predictor.score_model) reports the frozen model's AUC and the baseline's Brier score,
+nothing else about the baseline. The paper's Table A.5 and Section 4.5 also quote the baseline's AUC, so this module
+computes it the same way: the frozen baseline (logit P = a + b nodes + g log2 budget, frozen with the model, D090)
+predicts the H7 records of s2_ho_a0 and s2_ho_a16 (censored runs as failures, the registered budgets, the frozen
+features), and the AUC is predictor._auc, the statistic the registered scoring uses. The frozen model's AUC is
+recomputed beside it as a check against stage2.json. Output: data/analysis/baseline_auc.json.
+"""
+import json
+
+import numpy as np
+
+from reach.analysis.s2 import cgp_confirm, predictor
+from reach.analysis.s2 import stage2_report as S
+
+
+def auc_of(model, recs):
+    """AUC of a model's predictions on tidy records with outcome y, as the registered scoring computes it."""
+    y = np.array([r["y"] for r in recs], float)
+    return predictor._auc(y, predictor.predict(model, recs))
+
+
+def build(root):
+    inp = S.inputs(root)
+    rows, status, _ = S.phases(root)
+    why = S._pending("H7", status, False)
+    if why:
+        raise RuntimeError(why)
+    recs = []
+    for ph in S.TESTS["H7"]:
+        S._check_regime(ph, rows[ph])
+        recs += S._records(root, ph, rows[ph], predictor.SCORED["H7"]["budgets"], True)
+    recs = S._features(root, inp, recs)
+    h7 = inp["h7"]
+    out = {}
+    for d, rr in sorted(cgp_confirm.by_domain(recs).items()):
+        out[d] = dict(auc=auc_of(h7[d]["baseline"], rr), frozen_auc=auc_of(h7[d], rr), n=len(rr),
+                      sets=sorted({r["set"] for r in rr}))
+    return dict(label="DESCRIPTIVE: the frozen node-count baseline's AUC on the H7 records (D117)", **out)
+
+
+def main():
+    from reach.paths import ROOT
+    out = build(ROOT)
+    (ROOT / "data/analysis/baseline_auc.json").write_text(json.dumps(out, indent=1) + "\n")
+    for d in ("real", "bool"):
+        print(f"{d}: baseline AUC {out[d]['auc']:.4f}, frozen model AUC {out[d]['frozen_auc']:.4f}, n {out[d]['n']}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/reach/analysis/s2/ert.py b/src/reach/analysis/s2/ert.py
new file mode 100644
index 0000000000000000000000000000000000000000..e93930d100ab0785df95b136ef9ac46783c102e5
--- /dev/null
+++ b/src/reach/analysis/s2/ert.py
@@ -0,0 +1,61 @@
+"""Expected evaluations to success (ERT) beside the exact null (REQ-ANA-113; EXPLORATORY, descriptive on registered
+records; no test, no decision).
+
+ERT (Price 1997; Auger and Hansen 2005) of a group of runs with budget E: the evaluations all runs spent, a successful
+run counted to its first exact hit and an unsuccessful one at E, divided by the number of successes. It is the
+expected cost of reaching the target by independent restarts of E-evaluation runs; with no success it is infinite (the
+runs bound it from below: more than n x E / 1 when the next run would succeed).
+- Tree GP: a run succeeds within E iff `load.outcome(r, E / pop_size) == "success"`; its evaluations to the hit are
+  (gen_exact + 1) x pop_size (generation 0 evaluates the initial population; `h6d.runs_from_rows`). A run stopped on
+  its CPU limit or killed without a result is unsuccessful and charged E (the primary censoring rule); 'beyond' (E
+  above the run's own budget) and error rows are left out.
+- Cartesian GP: `load.outcome_cgp(r, E)`, evaluations to the hit `evals_exact`.
+The exact null enumerates distinct functions in size order. It covers level K after U(<=K) evaluations (`cover`; the
+registered reading, bits_sem = log2 U(<=K) up to the float-noise correction), and finds a target drawn uniformly from
+level K after U(<K) + (U(K) + 1) / 2 evaluations on average (`expected`; the uniform position its success share at a
+budget, `null.p_hit`, assumes). Gaps in bits: log2(null evaluations) - log2(ERT), positive when GP needs fewer.
+"""
+import math
+
+from reach.analysis.s2.load import outcome, outcome_cgp
+
+
+def spent(r, E, kind="tree"):
+    """(success, evaluations charged) of one run at budget E, or None when the run is left out."""
+    if kind == "tree":
+        o = outcome(r, round(E / r.get("pop_size", 100)))
+        hit = (r["gen_exact"] + 1) * r.get("pop_size", 100) if o == "success" else None
+    else:
+        o = outcome_cgp(r, E)
+        hit = r["evals_exact"] if o == "success" else None
+    if o in ("beyond", "error"):
+        return None
+    return (True, hit) if o == "success" else (False, E)
+
+
+def ert(rows, E, kind="tree"):
+    """ERT of the rows at budget E: dict(ert, successes, runs, evaluations)."""
+    got = [x for x in (spent(r, E, kind) for r in rows) if x is not None]
+    s = sum(ok for ok, _ in got)
+    total = sum(e for _, e in got)
+    return dict(ert=total / s if s else float("inf"), successes=s, runs=len(got), evaluations=total,
+                lower_bound=None if s else total)
+
+
+def null_evals(U, K):
+    """The exact null at level K of a set with level counts U {K: U(K)}: evaluations to cover the level, the expected
+    evaluations for a target drawn uniformly from it, and the counts."""
+    below = sum(u for k, u in U.items() if k < K)
+    return dict(cover=below + U[K], expected=below + (U[K] + 1) / 2, below=below, at=U[K])
+
+
+def null_success(U, K, E):
+    """The null's success probability within E evaluations on a uniform target of level K (`null.p_hit`)."""
+    n = null_evals(U, K)
+    return 1.0 if E >= n["cover"] else max(0.0, (E - n["below"]) / n["at"])
+
+
+def gap_bits(null_evaluations, ert_value):
+    if ert_value <= 0 or null_evaluations <= 0:
+        return float("nan")
+    return math.log2(null_evaluations) - math.log2(ert_value) if math.isfinite(ert_value) else float("-inf")
diff --git a/src/reach/analysis/s2/h11_report.py b/src/reach/analysis/s2/h11_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..6cf8d49d67ecf3c6ef0b1ef81e47cf097c7f2354
--- /dev/null
+++ b/src/reach/analysis/s2/h11_report.py
@@ -0,0 +1,148 @@
+"""H11 driver, Stage 4 (D100; REQ-ANA-96; docs/design/remedy.md).
+
+    python -m reach.analysis.s2.h11_report [--boot B]
+
+Refuses unless s4_restart holds exactly the registered tasks (data/registration/stage4_tasks.json) and every target
+file matches its .sha256. Sizes (bits_sem) of both arms come from the same registered target files, proven levels only.
+Restart arm: every s4_restart row per (set, target). One-run arm: s2_ho_a16 at 16 x E0 (`tidy`), checked against
+data/analysis/remedy.json (instrument check). Then `remedy.h11` with its registered constants, and the descriptive
+outputs. Writes data/analysis/h11.json and docs/status/h11_report.md.
+"""
+import argparse
+import hashlib
+import json
+import math
+import time
+from collections import defaultdict
+from pathlib import Path
+
+from reach import s2_lock as L
+from reach.analysis.s2 import law, remedy
+from reach.analysis.s2.load import read_phase, tidy
+
+SETS = ("R-ARITH", "R-ELEM6", "RS-add_sqrt", "RS-eml_sin_sqrt_square", "RS-mul_div_eml_sin_square", "RS-mul_eml_sin")
+TARGET_FILES = ("heldout", "restart")
+
+
+def check_complete(rows, registered):
+    """Refuse unless the rows' keys are exactly the registered task list (count and key hash)."""
+    if len(rows) != registered["n_tasks"] or L.task_list_hash(rows) != registered["sha256"]:
+        raise RuntimeError(f"s4_restart: {len(rows)} rows, key hash {L.task_list_hash(rows)[:16]}; registered "
+                           f"{registered['n_tasks']} tasks, {registered['sha256'][:16]}: incomplete or not the "
+                           "registered tasks")
+
+
+def load_sizes(root, sets):
+    """{set: {target_id: bits_sem}} over the registered target files present, proven levels only; each file checked
+    against its .sha256."""
+    out = {}
+    for g in sets:
+        out[g] = {}
+        for name in TARGET_FILES:
+            p = Path(root) / f"data/targets_s2/{g}/{name}.json"
+            if not p.exists():
+                continue
+            want = (p.parent / f"{name}.sha256").read_text().split()[0]
+            if hashlib.sha256(p.read_bytes()).hexdigest() != want:
+                raise RuntimeError(f"{p}: SHA-256 differs from {name}.sha256")
+            for t in json.loads(p.read_text()):
+                if t["K_proven"] == t["K_construction"] and not t.get("constructed"):
+                    out[g][t["target_id"]] = t["units"]["bits_sem"]
+    return out
+
+
+def build(root, sets=SETS, boot=remedy.H11_BOOT):
+    root = Path(root)
+    rows = read_phase("s4_restart", root)
+    check_complete(rows, json.loads((root / "data/registration/stage4_tasks.json").read_text())["s4_restart"])
+    sizes = load_sizes(root, sets)
+    restart = {}
+    for g in sets:
+        by = defaultdict(list)
+        for r in rows:
+            if r["set"] == g:
+                if r["target_id"] not in sizes[g]:
+                    raise RuntimeError(f"{g} {r['target_id']}: not a proven target of the registered files")
+                by[r["target_id"]].append(r)
+        restart[g] = (dict(by), {t: sizes[g][t] for t in by})
+    one = {}
+    recs = tidy([r for r in read_phase("s2_ho_a16", root) if r.get("set") in sets], (16,))
+    for g in sets:
+        rr = [r for r in recs if r["set"] == g]
+        missing = {r["target_id"] for r in rr} - set(sizes[g])
+        if missing:
+            raise RuntimeError(f"{g}: one-run targets not in the registered proven files: {sorted(missing)[:3]}")
+        one[g] = [dict(target_id=r["target_id"], y=r["y"], units={"bits_sem": sizes[g][r["target_id"]]}) for r in rr]
+    ref = json.loads((root / "data/analysis/remedy.json").read_text())["systems"]["tree GP, 16 x E0"]
+    for g in sets:                                           # instrument check of the one-run arm
+        k = law._k50(one[g], "bits_sem")
+        if not math.isclose(k, ref[g]["k50"], abs_tol=1e-9):
+            raise RuntimeError(f"instrument check: {g} one-run K50 {k} differs from remedy.json's {ref[g]['k50']}")
+    res = dict(label="STAGE 4 (H11; confirmatory once registered)", sets=list(sets), rows=len(rows),
+               h11=remedy.h11(restart, one, boot=boot), descriptive={})
+    null = res["h11"]["null"]
+    for g in sets:
+        runs, size = restart[g]
+        dr = {str(R): remedy.restart_k50(runs, size, R=R, L=100) for R in (2, 4, 8, 16, 32)}
+        l50 = remedy.restart_k50(runs, size, R=64, L=50)
+        gap = res["h11"]["per_set"][g]["gap"]
+        res["descriptive"][g] = dict(restarts_L100=dr, restarts_L50_R64=l50, eval_ratio=remedy.eval_ratio(gap),
+                                     gap_L50=l50["k50"] - null)
+    res["built"] = time.strftime("%Y-%m-%d %H:%M:%S")
+    return res
+
+
+def _f(x, d=2, sign=False):
+    if x is None or (isinstance(x, float) and math.isnan(x)):
+        return "n/a"
+    return f"{x:+.{d}f}" if sign else f"{x:.{d}f}"
+
+
+def render(res):
+    h = res["h11"]
+    L_ = [f"# H11 report: {res['label']}", "",
+          f"> Generated by `reach.analysis.s2.h11_report` ({res['built']}); every number from data/analysis/h11.json. "
+          f"Do not edit by hand. Rows {res['rows']}; bootstrap {h['boot']} replicates. The null's reach at 16 × E₀: "
+          f"{h['null']:.2f} bits.", "", "## Tests (Holm over the two)", "",
+          "| Test | estimate | 90% interval | margin | p | Holm threshold | estimable | supported |",
+          "|---|---|---|---|---|---|---|---|"]
+    for k in ("H11-1", "H11-2"):
+        t = h["tests"][k]
+        iv = f"[{_f(t.get('lo90'), sign=True)}, {_f(t.get('hi90'), sign=True)}]" if "lo90" in t else "per set"
+        L_.append(f"| {k} | {_f(t['estimate'], sign=True)} | {iv} | {t['margin']:+.0f} | {t['p']:.4f} | "
+                  f"{t['threshold']:.4f} | {'yes' if t['estimable'] else 'no'} | {'yes' if t['supported'] else 'no'} |")
+    sl = h["set_level"]
+    L_ += ["", f"Set level (descriptive): mean gap {_f(sl['mean'], sign=True)}, SE {_f(sl['se'])} over {sl['n_sets']} "
+           "sets.", "", "## Per set at 16 × E₀ (bits)", "",
+           "| set | restarted K₅₀ (32 × 100) | flag | one run K₅₀ | gap to null | gain | gain p | evaluation ratio |",
+           "|---|---|---|---|---|---|---|---|"]
+    for g, v in h["per_set"].items():
+        L_.append(f"| {g} | {_f(v['k50'])} | {'lower bound' if v['extrapolated'] else ''} | {_f(v['one_run'])} | "
+                  f"{_f(v['gap'], sign=True)} | {_f(v['gain'], sign=True)} | {h['per_set_gain_tests'][g]['p']:.4f} | "
+                  f"×{res['descriptive'][g]['eval_ratio']:.2f} |")
+    L_ += ["", "## Descriptive (no test)", "",
+           "| set | K₅₀ at R = 2, 4, 8, 16, 32 (L 100) | 64 × 50 generations: K₅₀ (gap) |", "|---|---|---|"]
+    for g, v in res["descriptive"].items():
+        ks = ", ".join(_f(v["restarts_L100"][R]["k50"]) + ("^" if v["restarts_L100"][R]["extrapolated"] else "")
+                       for R in ("2", "4", "8", "16", "32"))
+        L_.append(f"| {g} | {ks} | {_f(v['restarts_L50_R64']['k50'])} ({_f(v['gap_L50'], sign=True)}) |")
+    L_ += ["", "`^`: above the top tested level, replaced by it (a lower bound)."]
+    return "\n".join(L_) + "\n"
+
+
+def main(argv=None, root=None):
+    from reach.paths import ROOT
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--boot", type=int, default=remedy.H11_BOOT)
+    a = ap.parse_args(argv)
+    root = Path(root or ROOT)
+    res = build(root, boot=a.boot)
+    (root / "data/analysis/h11.json").write_text(json.dumps(res, indent=1, default=float) + "\n")
+    (root / "docs/status/h11_report.md").write_text(render(res))
+    t = res["h11"]["tests"]
+    print(f"written data/analysis/h11.json; H11-1 supported: {t['H11-1']['supported']}; "
+          f"H11-2 supported: {t['H11-2']['supported']}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/reach/analysis/s2/heldout_reach.py b/src/reach/analysis/s2/heldout_reach.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c04d1b88b4f570c1d166e85dc3b043f3b8b45f9
--- /dev/null
+++ b/src/reach/analysis/s2/heldout_reach.py
@@ -0,0 +1,189 @@
+"""Descriptive analyses on existing records for the paper (D111; REQ-ANA-97, REQ-ANA-98). No new runs.
+
+1. One-run reach per budget on the six real held-out sets: K50 (`law._k50`, bits_sem) at 1, 2, 4, 8 and 16 x E0
+   from the registered Stage 2 runs (s2_ho_a0 at E0; s2_ho_a16 with smaller budgets read as prefixes), the recipe
+   of `remedy.build` extended to the intermediate budgets. At 1 and 16 x E0 it must equal remedy.json's values.
+2. The exact null's reach read with GP's own estimator: the null's success at a level is the share of that level
+   the first E functions cover (`h6d.enum_probs`), and K50 is `h6d.k50_rates` on the set's proven restart targets.
+   The difference to log2 E is the estimator's offset for the null (the O of the decomposition, for E functions);
+   the restarted gap under that reading is K50(restarts) - K50(enum E).
+
+Output: data/analysis/heldout_reach.json, and the paper's value file (paper/scripts/values.py) when present.
+"""
+import importlib.util
+import json
+import math
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+
+from reach.analysis.s2 import confirm, h6d, law
+from reach.analysis.s2.load import read_phase, tidy
+
+SETS = ("R-ARITH", "R-ELEM6", "RS-add_sqrt", "RS-eml_sin_sqrt_square", "RS-mul_div_eml_sin_square", "RS-mul_eml_sin")
+BUDGETS = (1, 2, 4, 8, 16)
+E_RESTART = 320_000
+
+
+def tidy_rows(rows, budgets):
+    """Tidy records with units for regime A base runs; a run shorter than a budget does not enter it ('beyond')."""
+    rows = [r for r in rows if r.get("algorithm", "A") == "A" and r.get("config", "base") == "base"]
+    recs = tidy(rows, budgets)
+    for r in recs:
+        if not r.get("units"):
+            r["units"] = {"bits_sem": None}
+    return [r for r in recs if r["units"].get("bits_sem") is not None]
+
+
+def k50_by_budget(recs):
+    return {b: law._k50([r for r in recs if r["budget"] == b], "bits_sem") for b in sorted({r["budget"] for r in recs})}
+
+
+def one_run_curves(root):
+    rows = [r for ph in ("s2_ho_a0", "s2_ho_a16") for r in read_phase(ph, root) if r.get("set") in SETS]
+    confirm._load_units(root, list(SETS), "heldout")
+    recs = [r for r in confirm._with_units(tidy_rows(rows, BUDGETS)) if r["units"].get("bits_sem") is not None]
+    by = defaultdict(list)
+    for r in recs:
+        by[r["set"]].append(r)
+    out = {}
+    for s in SETS:
+        top = max(r["units"]["bits_sem"] for r in by[s])
+        ks = k50_by_budget(by[s])
+        out[s] = {str(b): dict(k50=k, extrapolated=bool(np.isfinite(k) and k > top)) for b, k in ks.items()}
+    return out
+
+
+def counts_path(root, s):
+    for p in (Path(root) / f"data/enumeration_s2/{s}/counts.json", Path(root) / f"data/enumeration_s2/random/{s}/counts.json"):
+        if p.exists():
+            return p
+    raise FileNotFoundError(s)
+
+
+def level_counts(root, s):
+    levels = json.loads(counts_path(root, s).read_text())["levels"]
+    return {l["K"]: l["U"] for l in levels}
+
+
+def proven_targets(root, s):
+    out = []
+    for name in ("heldout", "restart"):
+        p = Path(root) / f"data/targets_s2/{s}/{name}.json"
+        if p.exists():
+            out += [dict(K=t["K_construction"], bits_sem=t["units"]["bits_sem"])
+                    for t in json.loads(p.read_text()) if not t.get("constructed") and t["K_proven"] == t["K_construction"]]
+    return out
+
+
+def null_k50_under_estimator(targets, U, E):
+    """K50 of exact enumeration of E functions, read with GP's estimator on the targets' levels."""
+    return h6d.k50_rates(targets, h6d.enum_probs(E, U))
+
+
+def null_estimator(root, E=E_RESTART):
+    h11 = json.loads((Path(root) / "data/analysis/h11.json").read_text())["h11"]["per_set"]
+    out = {}
+    for s in SETS:
+        U = level_counts(root, s)
+        if sum(U.values()) < E:
+            out[s] = dict(k50_enum=float("nan"), log2E=math.log2(E), offset=float("nan"), note="enumeration smaller than E")
+            continue
+        k = null_k50_under_estimator(proven_targets(root, s), U, E)
+        out[s] = dict(k50_enum=k, log2E=math.log2(E), offset=k - math.log2(E),
+                      k50_restart=h11[s]["k50"], gap_registered=h11[s]["gap"], gap_estimator=h11[s]["k50"] - k)
+    return out
+
+
+CAL_REAL = ("F-EML", "F-EML-R", "F-LDE0", "R-ARITH4", "R-ELEM4", "R-HYB", "R-TRIG")
+CAL_BOOL = ("BOOL-NAND-n5", "BOOL-NOR-n5", "BOOL-IMP0-n5", "BOOL-IMP0R-n5", "BOOL-AON-n5", "BOOL-AONX-n5", "BOOL-RICH-n5")
+
+
+def null_offsets_calibration(root, E=20_000):
+    """The null read with GP's estimator on the 14 calibration sets at E0: per set K50 of exact enumeration of E
+    functions under the logistic estimator over the set's own targets (all ten levels), its offset to log2 E, and the
+    registered-unit gap under both readings (sign per set under each)."""
+    from reach.analysis.s2 import law as _law
+    rows_all = [r for ph in ("s2_cal_a0", "s2_cal_a16") for r in read_phase(ph, root)
+                if r.get("algorithm") == "A" and r.get("config") == "base"]
+    out = {}
+    for s in CAL_REAL + CAL_BOOL:
+        rows = [r for r in rows_all if r.get("set") == s]
+        confirm._load_units(root, [s], "calibration")
+        recs = [r for r in confirm._with_units(tidy(rows, (1,))) if r["units"].get("bits_sem") is not None]
+        U = level_counts(root, s)
+        tg = [dict(K=r["K"], bits_sem=r["units"]["bits_sem"]) for r in recs]
+        k_gp = _law._k50(recs, "bits_sem")
+        k_en = null_k50_under_estimator(tg, U, E)
+        out[s] = dict(k50_gp=k_gp, k50_enum=k_en, offset=k_en - math.log2(E), gap_exact=k_gp - math.log2(E),
+                      gap_estimator=k_gp - k_en, real=not s.startswith("BOOL"))
+    for dom, sets in (("real", CAL_REAL), ("bool", CAL_BOOL)):
+        v = [out[s] for s in sets]
+        out[f"{dom}_mean"] = dict(offset=float(np.mean([x["offset"] for x in v])),
+                                 gap_exact=float(np.mean([x["gap_exact"] for x in v])),
+                                 gap_estimator=float(np.mean([x["gap_estimator"] for x in v])),
+                                 signs_agree=bool(all((x["gap_exact"] < 0) == (x["gap_estimator"] < 0) for x in v)))
+    return out
+
+
+def null_estimator_by_budget(root, budgets=BUDGETS):
+    """The null read with GP's estimator on the six held-out sets at every budget (for the second null line of the
+    reach figure): per budget, the mean over sets of K50(enum B x E0) under the estimator, with the per-set values."""
+    out = {}
+    for B in budgets:
+        E = B * 20_000
+        per = {}
+        for s in SETS:
+            U = level_counts(root, s)
+            per[s] = null_k50_under_estimator(proven_targets(root, s), U, E) if sum(U.values()) >= E else float("nan")
+        vals = [v for v in per.values() if np.isfinite(v)]
+        out[str(B)] = dict(mean=float(np.mean(vals)), log2E=math.log2(E), per_set=per)
+    return out
+
+
+def build(root):
+    one = one_run_curves(root)
+    nul = null_estimator(root)
+    cal = null_offsets_calibration(root)
+    nb = null_estimator_by_budget(root)
+    finite = [v["gap_estimator"] for v in nul.values() if np.isfinite(v.get("gap_estimator", float("nan")))]
+    offs = [v["offset"] for v in nul.values() if np.isfinite(v.get("offset", float("nan")))]
+    return dict(label="DESCRIPTIVE on registered records (D111); no new runs; not confirmatory",
+                sets=list(SETS), budgets=list(BUDGETS), one_run=one, null_estimator=nul, null_estimator_by_budget=nb, calibration_offsets=cal,
+                summary=dict(mean_offset=float(np.mean(offs)), mean_gap_estimator=float(np.mean(finite)),
+                             mean_gap_registered=float(np.mean([v["gap_registered"] for v in nul.values()])),
+                             sets_below_margin_estimator=int(sum(g < -1 for g in finite)),
+                             one_run_mean={str(b): float(np.mean([one[s][str(b)]["k50"] for s in SETS])) for b in BUDGETS}))
+
+
+def record_values(out, root):
+    """The paper's value recorder (paper/scripts/values.py), when present."""
+    p = Path(root) / "paper/scripts/values.py"
+    if not p.exists():
+        return False
+    spec = importlib.util.spec_from_file_location("values", p)
+    values = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(values)
+    values.record("heldout_reach", dict(one_run=out["one_run"], null_estimator=out["null_estimator"], calibration_offsets=out["calibration_offsets"], null_estimator_by_budget=out["null_estimator_by_budget"], summary=out["summary"]))
+    return True
+
+
+def main():
+    from reach.paths import ROOT
+    out = build(ROOT)
+    (ROOT / "data/analysis/heldout_reach.json").write_text(json.dumps(out, indent=1) + "\n")
+    recorded = record_values(out, ROOT)
+    s = out["summary"]
+    print(f"one-run mean K50 by budget: { {b: round(v, 2) for b, v in s['one_run_mean'].items()} }")
+    print(f"null under the estimator: mean offset {s['mean_offset']:+.2f} bits; restarted gap {s['mean_gap_registered']:+.2f} "
+          f"registered -> {s['mean_gap_estimator']:+.2f} under the estimator; sets below -1: {s['sets_below_margin_estimator']}")
+    for st, v in out["null_estimator"].items():
+        print(f"  {st:28s} K50(enum E) {v.get('k50_enum', float('nan')):6.2f}  offset {v.get('offset', float('nan')):+.2f}  gap {v.get('gap_registered', float('nan')):+.2f} -> {v.get('gap_estimator', float('nan')):+.2f}")
+    c = out["calibration_offsets"]
+    print(f"calibration offsets at E0: real {c['real_mean']['offset']:+.2f} (gap {c['real_mean']['gap_exact']:+.2f} -> {c['real_mean']['gap_estimator']:+.2f}), bool {c['bool_mean']['offset']:+.2f} (gap {c['bool_mean']['gap_exact']:+.2f} -> {c['bool_mean']['gap_estimator']:+.2f})")
+    print("values recorded" if recorded else "paper tools not present")
+
+
+if __name__ == "__main__":
+    main()
