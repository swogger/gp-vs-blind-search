+@phase("s5_pilot_keys", "Stage 5 pilot (never confirmatory): 100-generation base runs with the counter and key sets "
+       "on the pilot targets of F-EML and R-ARITH4 x 16 seeds of the slice s5_pilot (union check, cost).")
+def s5_pilot_keys():
