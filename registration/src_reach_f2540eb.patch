+                     f"{f(p['ratio'])} | {f(p['slope'])} | {f(t['diff'])} [{f(t['lo'])}, {f(t['hi'])}] | {fp(t['p'])} | "
+                     f"{_inf(p['lstar'])} [{_inf(m['lstar_ci']['lo'])}, {_inf(m['lstar_ci']['hi'])}] | "
