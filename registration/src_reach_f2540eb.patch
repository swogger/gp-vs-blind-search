+                null = 0.0 if x == "A" else -REGISTERED["h5_margin"]
+                c.update(p=law.p_bound(c.pop("reps"), null, "above", 2), test=families.TESTS[f"{x}-{y}"])
+                res["h5"][g][f"{x}-{y}"] = c
+                res["h5_mcnemar"].setdefault(g, {})[f"{x}-{y}"] = contrasts.mcnemar_per_level(both, x, y)
