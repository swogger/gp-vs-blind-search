@@ -0,0 +1,75 @@
+"""Draw the random held-out set candidates (T26; D064) -> data/registration/random_draw.json (written once).
+
+    python -m reach.tasks.s2_random_draw --osf a3spg
+
+Seed: `s2_random_sets.draw_seed` of the Stage 1 OSF identifier, plus 0 (real) or 1 (Boolean), as in the Stage 0 draw.
+N_CANDIDATES accepted candidates per domain, in draw order; they are enumerated in that order, and the held-out sets
+are the first 4 per domain whose proven ceiling is at least 10 nodes. Every candidate is locked (s2_lock.held_out)."""
+import argparse
+import hashlib
+import json
+
+from reach.paths import ROOT
+from reach.s2_lock import RANDOM_FILE
+from reach.tasks import s2_random_sets as R
+
+N_CANDIDATES = 10
+
+
+def draw(osf_id):
+    seed = R.draw_seed(osf_id)
+    out = dict(osf_id=osf_id.lower(), seed=seed, rule="first 4 per domain, in order, with proven ceiling >= 10",
+               code_sha256=hashlib.sha256((ROOT / "src/reach/tasks/s2_random_sets.py").read_bytes()).hexdigest())
+    for i, dom in enumerate(("real", "bool")):
+        cands = R.draw_candidates(dom, seed + i, n=N_CANDIDATES)
+        for c in cands:
+            c["name"] = R.make_grammar(dom, c["ops"], c["constants"]).name
+        out[dom] = dict(seed=seed + i, candidates=cands)
+    return out
+
+
+def heldout_sets(rec, ceilings, n=4):
+    """The registered rule: per domain, the first n candidates in draw order whose proven ceiling is at least 10.
+    A candidate before the n-th accepted one without an enumeration is an error (the order decides)."""
+    out = {}
+    for dom in ("real", "bool"):
+        got = []
+        for c in rec[dom]["candidates"]:
+            if len(got) == n:
+                break
+            if c["name"] not in ceilings:
+                raise ValueError(f"{c['name']} is not enumerated yet; the draw order decides")
+            if ceilings[c["name"]] >= 10:
+                got.append(c["name"])
+        out[dom] = got
+    return out
+
+
+def heldout_from_files(root=None):
+    from reach.analysis.s2.phase1 import enum_dir
+    rec = json.loads(RANDOM_FILE.read_text())
+    ceil = {}
+    for dom in ("real", "bool"):
+        for c in rec[dom]["candidates"]:
+            p = enum_dir(c["name"]) / "counts.json"
+            if p.exists():
+                ks = [st["K"] for st in json.loads(p.read_text())["levels"] if st["U"] > 0 and st["K"] >= 3]
+                if ks:
+                    ceil[c["name"]] = max(ks)
+    return heldout_sets(rec, ceil)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--osf", required=True, help="the Stage 1 OSF identifier")
+    a = ap.parse_args()
+    if RANDOM_FILE.exists():
+        raise SystemExit(f"{RANDOM_FILE} exists: the draw is done once")
+    rec = draw(a.osf)
+    RANDOM_FILE.write_text(json.dumps(rec, indent=1) + "\n")
+    for dom in ("real", "bool"):
+        print(dom, [c["name"] for c in rec[dom]["candidates"]])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/reach/tasks/s2_random_sets.py b/src/reach/tasks/s2_random_sets.py
new file mode 100644
index 0000000000000000000000000000000000000000..2d76b6760edc01efd6fcfab2544ea309670b2b63
--- /dev/null
+++ b/src/reach/tasks/s2_random_sets.py
@@ -0,0 +1,122 @@
+"""Random held-out function sets (tool T26; D053; docs/design/function_sets.md, "Held-out sets (b)").
+
+Universes: real {+, -, *, /, exp, log, sin, cos, sqrt, square, eml} with constant 1 (guarded semantics); Boolean the 10
+non-trivial two-input gates, not, and the constants 0 and 1. Draw a size k uniformly (real 2-5, Boolean 2-4), then a
+uniform subset of that size; reject (and log) a real set without a binary operator, a Boolean set that is not
+functionally complete (Post's criterion, validated against enumeration in tests), and any set equal to a listed set.
+The ceiling rule (>= 10) is applied after enumeration, and the next candidate replaces a failing one. The seed comes
+from the Stage 1 registration (`draw_seed` of its OSF identifier, plus 0 for real and 1 for Boolean, as in Stage 0);
+the draw runs only after that filing (D064).
+"""
+import random
+
+from reach import grammar as G
+from reach import s2_sets as S
+
+REAL_UNIVERSE = ["+", "-", "*", "/", "exp", "log", "sin", "cos", "sqrt", "square", "eml"]
+BOOL_GATES = ["and", "or", "nand", "nor", "xor", "xnor", "imp", "rimp", "nimp", "rnimp"]
+BOOL_UNIVERSE = BOOL_GATES + ["not", "c0", "c1"]
+
+
+def _table(sym):
+    """Truth table of a symbol as a dict from argument tuples to 0/1 (constants are nullary)."""
+    if sym in ("c0", "c1"):
+        return {(): int(sym[1])}
+    if sym == "not":
+        return {(a,): 1 - a for a in (0, 1)}
+    m = 1
+    f = G.BOOL_OPS[sym].fn
+    return {(a, b): f(m, a, b) & 1 for a in (0, 1) for b in (0, 1)}
+
+
+def is_complete(ops, consts):
+    """Post's functional completeness: for each of the five maximal clones, some symbol lies outside it."""
+    syms = list(ops) + [f"c{c}" for c in consts]
+    tabs = [_table(s) for s in syms]
+    def out_t0(t): return t[tuple(0 for _ in next(iter(t)))] != 0
+    def out_t1(t): return t[tuple(1 for _ in next(iter(t)))] != 1
+    def out_mono(t): return any(t[x] > t[y] for x in t for y in t if all(a <= b for a, b in zip(x, y)))
+    def out_selfdual(t): return any(t[x] == t[tuple(1 - a for a in x)] for x in t) if next(iter(t)) != () else True
+    def out_affine(t):
+        n = len(next(iter(t)))
+        for c0 in (0, 1):
+            for coef in range(1 << n):
+                if all(t[x] == (c0 ^ (sum(((coef >> i) & 1) * x[i] for i in range(n)) & 1)) for x in t):
+                    return False
+        return True
+    return all(any(test(t) for t in tabs) for test in (out_t0, out_t1, out_mono, out_selfdual, out_affine))
+
+
+def listed_symbol_sets(domain):
+    out = []
+    for name, s in S.SETS.items():
+        if s["domain"] != domain:
+            continue
+        g = G.get(name)
+        syms = list(g.operators)
+        if domain == "bool":
+            syms += [f"c{c}" for c in g.constants]
+        out.append(syms)
+    return out
+
+
+SAFE = {"+": "add", "-": "sub", "*": "mul", "/": "div"}          # path-safe names (an enumeration is a folder)
+UNSAFE = {v: k for k, v in SAFE.items()}
+
+
+def draw_seed(osf_id):
+    """The first 8 bytes (big-endian) of the SHA-256 of the Stage 1 OSF identifier (lower case), as the Stage 0 draw
+    used the set-list file: OSF assigns the identifier, so nobody can choose the seed."""
+    import hashlib
+    return int.from_bytes(hashlib.sha256(osf_id.lower().encode()).digest()[:8], "big")
+
+
+def grammar_from_name(name):
+    """Rebuild a random set from its name (G.get calls this in any process, e.g. the enumeration task)."""
+    if name.startswith("BOOL-RS-"):
+        body, n = name[len("BOOL-RS-"):].rsplit("-n", 1)
+        parts = body.split("_")
+        return make_grammar("bool", [p for p in parts if not p.startswith("c")],
+                            [int(p[1]) for p in parts if p.startswith("c")], int(n))
+    if name.startswith("RS-"):
+        return make_grammar("real", [UNSAFE.get(p, p) for p in name[len("RS-"):].split("_")], [])
+    raise KeyError(name)
+
+
+def make_grammar(domain, ops, consts, n=5):
+    if domain == "real":
+        name = "RS-" + "_".join(SAFE.get(o, o) for o in ops)
+        g = G.Grammar(name, "real", tuple(G.GUARDED_OPS[o] for o in ops), ("x",), (1.0,))
+    else:
+        name = f"BOOL-RS-{'_'.join(ops)}{''.join(f'_c{c}' for c in consts)}-n{n}"
+        g = G.Grammar(name, "bool", tuple(G.BOOL_OPS[o] for o in ops), tuple(f"x{i + 1}" for i in range(n)),
+                      tuple(consts), n)
+    G.GRAMMARS[name] = g
+    return g
+
+
+def draw_candidates(domain, seed, n=4, max_tries=10_000):
+    """The first n accepted candidates in draw order (a later ceiling failure takes the next one), with the log."""
+    rng = random.Random(seed)
+    listed = {frozenset(s) for s in listed_symbol_sets(domain)}
+    out, seen = [], set()
+    for _ in range(max_tries):
+        if len(out) == n:
+            break
+        if domain == "real":
+            k = rng.randint(2, 5)
+            ops = sorted(rng.sample(REAL_UNIVERSE, k))
+            consts, key = [], frozenset(ops)
+            if not any(G.REAL_SYMBOL_ARITY[o] == 2 for o in ops) or key in listed or key in seen:
+                continue
+        else:
+            k = rng.randint(2, 4)
+            syms = sorted(rng.sample(BOOL_UNIVERSE, k))
+            ops = [s for s in syms if not s.startswith("c")]
+            consts = [int(s[1]) for s in syms if s.startswith("c")]
+            key = frozenset(syms)
+            if not ops or key in listed or key in seen or not is_complete(ops, consts):
+                continue
+        seen.add(key)
+        out.append(dict(domain=domain, k=k, ops=ops, constants=consts))
+    return out
diff --git a/src/reach/tasks/s2_revisit_rand.py b/src/reach/tasks/s2_revisit_rand.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c55e25c8c42edd6fa88f7d4e2edeb8ea6b93629
--- /dev/null
+++ b/src/reach/tasks/s2_revisit_rand.py
@@ -0,0 +1,30 @@
+"""Negative control for H6d (D098; design 4.5; REQ-RUN-40): trees drawn exactly as the random-sampling baseline draws
+them (`s2_random.draw_trees`, no other random draw), shown to the H6d counter in batches of 100 with no target, so the
+unguided twin of a blind sampler can be set against the sampler's own hit rate (its registered hits, s2_cal_rand).
+
+    python -m reach.tasks.s2_revisit_rand --set S --enum_dir DIR --seed 30000000 --n 20000   -> RESULT line
+"""
+import argparse
+import json
+
+from reach import grammar as G
+from reach import revisit as V
+from reach.tasks.s2_random import draw_trees
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--set", required=True)
+ap.add_argument("--enum_dir", required=True)
+ap.add_argument("--seed", type=int, required=True)
+ap.add_argument("--n", type=int, required=True)
+a = ap.parse_args()
+g = G.get(a.set)
+c = V.Counter(g, None, V.Lookup(g, a.enum_dir), 100, [p for p in V.PREFIXES if p <= a.n])
+batch = []
+for tree in draw_trees(g, a.n, a.seed):
+    batch.append(tree)
+    if len(batch) == 100:
+        c.generation(batch)
+        batch = []
+if batch:
+    c.generation(batch)
+print("RESULT " + json.dumps(dict(set=g.name, domain=g.kind, seed=a.seed, n=a.n, rv=c.record())), flush=True)
diff --git a/src/reach/tasks/s2_run.py b/src/reach/tasks/s2_run.py
new file mode 100644
index 0000000000000000000000000000000000000000..a3c82669a2331182d2a09fadb5523131b9177702
--- /dev/null
+++ b/src/reach/tasks/s2_run.py
@@ -0,0 +1,88 @@
+"""One Study 2 search run -> one `RESULT {json}` line (tool T6; C6; REQ-RUN-08).
+
+Every scientific setting is required: there are no defaults for algorithm, configuration, penalty, stop rule, seeded
+leaf, budget or CPU limit (the archived pilot ran on silent defaults; review F8, F12). The task refuses held-out sets
+before the Stage 2 registration (s2_lock) and a target file whose SHA-256 differs from the one given (REQ-MEA-10).
+With stop on exact, `gen_exact` is the generation of the first exact match, so every shorter budget is read from this
+run (C2); a run stopped by its CPU limit records the generation it reached (REQ-RUN-15).
+"""
+import argparse
+import hashlib
+import json
+import sys
+
+from reach import grammar as G
+from reach.engines.treegp import run_gp
+from reach.s2_lock import check_search_allowed
+from reach.tasks.s2_configs import CONFIGS
+
+VAL_SEED = 20260721 + 1          # EML-GP's validation stream (as all paper-1 and Study 2 tasks)
+ALGORITHMS = {"A": dict(regime="A", crossover_mode="subtree"), "B": dict(regime="B", crossover_mode="subtree"),
+              "HC": dict(regime="A", crossover_mode="headless")}
+
+ap = argparse.ArgumentParser()
+req = dict(required=True)
+ap.add_argument("--set", **req)
+ap.add_argument("--targets", **req)
+ap.add_argument("--target_id", **req)
+ap.add_argument("--targets_sha256", **req)
+ap.add_argument("--algorithm", choices=sorted(ALGORITHMS), **req)
+ap.add_argument("--config", choices=sorted(CONFIGS), **req)
+ap.add_argument("--seed", type=int, **req)
+ap.add_argument("--generations", type=int, **req)
+ap.add_argument("--pop_size", type=int, **req)
+ap.add_argument("--penalty", choices=["scaled", "fixed"], **req)
+ap.add_argument("--stop_on", choices=["exact"], **req)
+ap.add_argument("--seed_leaves", choices=["off", "on"], **req)
+ap.add_argument("--timeout", type=float, help="CPU seconds (soft limit; the queue adds a hard limit)", **req)
+ap.add_argument("--print_tree", action="store_true",
+                help="also record best_expr_full, the whole best tree (reruns, D091; changes nothing else)")
+ap.add_argument("--count_distinct", action="store_true",
+                help="also record rv: distinct functions per budget prefix (H6d re-runs, D098; changes nothing else)")
+ap.add_argument("--enum_dir", help="the set's enumeration, for --count_distinct")
+a = ap.parse_args()
+if a.count_distinct and not a.enum_dir:
+    sys.exit("refused: --count_distinct needs --enum_dir")
+
+try:
+    check_search_allowed(a.set)
+except PermissionError as err:
+    sys.exit(f"refused: {err}")
+raw = open(a.targets, "rb").read()
+sha = hashlib.sha256(raw).hexdigest()
+if sha != a.targets_sha256:
+    sys.exit(f"refused: target file checksum {sha} differs from the registered {a.targets_sha256}")
+
+cfg = CONFIGS[a.config]
+if a.pop_size != cfg["pop_size"]:
+    sys.exit(f"refused: configuration {a.config} has population {cfg['pop_size']}, not {a.pop_size}")
+g = G.get(a.set)
+tgt = next(t for t in json.loads(raw) if t["target_id"] == a.target_id)
+tree = G.parse_expr(tgt["expression"], g)
+kw = {}
+if g.kind == "real":
+    grid, val = G.sample_grid(g), G.sample_val(g, VAL_SEED)
+    kw = dict(val_xs=val, val_target=G.evaluate(g, tree, val), var_norm=tgt["var_target"], grid_xs=grid,
+              grid_target=G.evaluate(g, tree, grid), grid_scale=tgt["target_scale"])
+counter = None
+if a.count_distinct:
+    from reach import revisit
+    counter = revisit.Counter(g, tree, revisit.Lookup(g, a.enum_dir), a.pop_size,
+                              [p for p in revisit.PREFIXES if p <= a.pop_size * a.generations])
+r = run_gp(g, tree, ALGORITHMS[a.algorithm]["regime"], a.seed, generations=a.generations, pop_size=a.pop_size,
+           timeout_seconds=a.timeout, legacy=False, seed_leaves=a.seed_leaves == "on", stop_on=a.stop_on,
+           undefined_penalty=a.penalty, crossover_mode=ALGORITHMS[a.algorithm]["crossover_mode"], full_expr=a.print_tree,
+           counter=counter,
+           **cfg["kwargs"], **kw)
+exact = bool(r["exact_hash_match"]) and r["terminal_state"] == "converged"
+print("RESULT " + json.dumps(dict(
+    set=g.name, domain=g.kind, algorithm=a.algorithm, config=a.config, seed=a.seed, target_id=tgt["target_id"],
+    K_proven=tgt.get("K_proven"), K_construction=tgt.get("K_construction"), units=tgt.get("units"),
+    budget_E=a.pop_size * a.generations, generations=a.generations, pop_size=a.pop_size, evals_per_gen=a.pop_size,
+    penalty=a.penalty, stop_on=a.stop_on, seed_leaves=a.seed_leaves, exact=exact, converged=bool(r["converged"]),
+    gen_exact=r["gens_run"] if exact else None, gen_tol=r["gens_to_converge"], gens_reached=r["gens_run"],
+    terminal_state=r["terminal_state"], final_error=r["final_nmse"], final_tree_size=r["final_tree_size"],
+    cpu_seconds=r["cpu_seconds"], wall_seconds=r["wall_seconds"], best_expr=r["best_expr"], targets_sha256=sha,
+    **({"best_expr_full": r["best_expr_full"]} if a.print_tree else {}),
+    **({"rv": counter.record()} if counter is not None else {})),
+    default=float), flush=True)
diff --git a/src/reach/tasks/s2_targets.py b/src/reach/tasks/s2_targets.py
new file mode 100644
index 0000000000000000000000000000000000000000..e1f84ffc896cf6751cddd89e53ad6bc8f9dcd258
--- /dev/null
+++ b/src/reach/tasks/s2_targets.py
@@ -0,0 +1,40 @@
+"""Generate and freeze Study 2 targets for one set (tool T4) -> data/targets_s2/<set>/<name>.json (+ log, .sha256).
+
+    python -m reach.tasks.s2_targets --grammar R-ARITH4 --name pilot --n 10 --seed 20261020 [--levels 5,7,9]
+
+Without --levels, the pilot levels (`s2_targets.pilot_levels`) are used. Real sets load the enumerated values for the
+near-duplicate filter and compute the float-noise rows (D050) for bits_sem. Prints one RESULT line."""
+import argparse
+import json
+
+from reach import grammar as G
+from reach import s2_targets as T
+from reach.analysis.s2.phase1 import enum_dir, inflation_from
+from reach.enumerate import Enumerator
+from reach.paths import ROOT
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--grammar", required=True)
+ap.add_argument("--name", required=True)
+ap.add_argument("--n", type=int, required=True)
+ap.add_argument("--seed", type=int, required=True)
+ap.add_argument("--levels", default="", help="comma-separated sizes; default: pilot levels")
+a = ap.parse_args()
+g = G.get(a.grammar)
+d = enum_dir(g.name)
+stats = json.loads((d / "counts.json").read_text())["levels"]
+if a.levels:
+    levels = [int(k) for k in a.levels.split(",")]
+else:
+    proven, constructed = T.pilot_levels(stats)
+    levels = proven + constructed
+vals = noise = None
+if g.kind == "real":
+    e = Enumerator(g, d, log=lambda *_: None)
+    e.load()
+    vals, noise = e.vals, inflation_from(e)
+ts, log = T.generate(g, d, levels, a.n, a.seed, vals=vals, noise_rows=noise)
+p = T.write_frozen(ROOT / "data/targets_s2" / g.name, a.name, ts, log)
+found = {k: v["found"] for k, v in log["levels"].items()}
+print("RESULT " + json.dumps(dict(grammar=g.name, terminal_state="completed", targets=len(ts), file=str(p.relative_to(ROOT)),
+                                  found=found)), flush=True)
diff --git a/src/reach/units.py b/src/reach/units.py
new file mode 100644
index 0000000000000000000000000000000000000000..568eb9d729fb681a14b3a3355d9e3867b20c3b54
--- /dev/null
+++ b/src/reach/units.py
@@ -0,0 +1,83 @@
+"""Size units of a target (tool T5; brief §7.3; REQ-MEA-09, REQ-MEA-21).
+
+nodes K; bits_uniform K·log2(r) with r symbols (terminals included); bits_syn log2 N_G(<=K) (syntactic count,
+exact recurrence); bits_sem log2 U_G(<=K) (distinct functions from the enumeration), by default corrected for
+float-noise duplicates (D050: per-level `noise` rows from the Phase 1 report; a level above the measured ones takes the
+share of the highest measured level). Above the enumeration ceiling bits_sem is extrapolated from a least-squares line
+of log2 U_cum on K over the last `fit_levels` non-empty levels, and flagged.
+
+fit_levels = 3 was chosen on held-back levels of 12 enumerations (2026-10-19): mean error +0.006 bits, mean absolute
+0.15, maximum 0.51 (5 levels: biased low, mean -0.05, maximum -0.79; quadratic fits biased high). Analyses that use
+extrapolated values carry this error."""
+import math
+
+import numpy as np
+
+from reach import grammar as G
+
+
+def space_bits(g):
+    """The largest possible size in bits_sem: a Boolean set with n inputs has 2^(2^n) functions, so 2^n bits; real
+    sets have no bound (REQ-MEA-32). The registered unit below extrapolates above the enumeration ceiling without this
+    bound (guardrail row 154)."""
+    return float(1 << g.n_inputs) if g.kind == "bool" else math.inf
+
+
+def capped(bits, g):
+    """A bits_sem value capped at the set's space bound."""
+    return min(bits, space_bits(g))
+
+
+class SizeUnits:
+    def __init__(self, g, levels, noise_rows=None, fit_levels=3):
+        a0, a1, a2 = g.arity_counts()
+        self.r = a0 + a1 + a2
+        self.U = {st["K"]: st["U"] for st in levels}
+        self.top = max(self.U)
+        self.syn = G.syntactic_counts(g, max(400, self.top + 200))
+        self.noise = {row["K"]: row["noise"] for row in (noise_rows or [])}
+        self.noise_top = max(self.noise) if self.noise else None
+        self._fits = {c: self._fit(c, fit_levels) for c in (True, False)}
+
+    def _noise_at(self, k):
+        if not self.noise:
+            return 0
+        if k in self.noise:
+            return self.noise[k]
+        if k > self.noise_top:
+            ref = self.noise_top
+            return int(round(self.U.get(k, 0) * self.noise[ref] / max(self.U[ref], 1)))
+        return 0
+
+    def _ucum(self, K, corrected):
+        return sum(self.U[k] - (self._noise_at(k) if corrected else 0) for k in self.U if k <= K)
+
+    def _fit(self, corrected, n):
+        pts = [(k, math.log2(self._ucum(k, corrected))) for k in sorted(self.U) if k > 1 and self.U[k] > 0][-n:]
+        if len(pts) < 2:
+            return None
+        k, y = np.array(pts).T
+        slope, icpt = np.polyfit(k, y, 1)
+        return float(slope), float(icpt)
+
+    def nodes(self, K):
+        return float(K)
+
+    def bits_uniform(self, K):
+        return K * math.log2(self.r)
+
+    def bits_syn(self, K):
+        return math.log2(sum(self.syn[1:K + 1]))
+
+    def bits_sem(self, K, corrected=True, with_flag=False):
+        if K <= self.top:
+            v, flag = math.log2(self._ucum(K, corrected)), False
+        else:
+            slope, icpt = self._fits[corrected]
+            v, flag = icpt + slope * K, True
+        return (v, flag) if with_flag else v
+
+    def all(self, K):
+        sem, flag = self.bits_sem(K, with_flag=True)
+        return dict(nodes=self.nodes(K), bits_uniform=self.bits_uniform(K), bits_syn=self.bits_syn(K),
+                    bits_sem=sem, bits_sem_uncorrected=self.bits_sem(K, corrected=False), bits_sem_extrapolated=flag)
