diff --git a/src/reach/tasks/s2_operon.py b/src/reach/tasks/s2_operon.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc48e47b95a07753e6db91b6b7404141c7fea6fc
--- /dev/null
+++ b/src/reach/tasks/s2_operon.py
@@ -0,0 +1,66 @@
+"""One Operon run (tool T20; H9; D056) -> one `RESULT {json}` line. Runs in .venv-ext (Python 3.11, pyoperon 0.6.2)
+with DYLD_LIBRARY_PATH=.venv-ext/operon-libs and PYTHONPATH=src.
+
+Training data: 75 points drawn uniformly on (2, 3) with the run's seed (fixed for the run). Budget: max_evaluations =
+budget x 2x10^4 (one run per budget; no prefix property, D056). Configurations: "symbolic" (symbolic_mode, integer
+coefficients, objective mse) and "default" (Operon's practitioner setting: R^2 objective, 10 local-search iterations).
+Exactness is scored in double precision (s2_operon_score). Held-out sets are refused before Stage 2 (s2_lock)."""
+import argparse
+import hashlib
+import json
+import sys
+import time
+
+import numpy as np
+
+from reach import grammar as G
+from reach.s2_lock import check_search_allowed
+from reach.tasks.s2_operon_score import is_exact
+
+SYMBOLS = {"R-ARITH": "add,sub,mul", "R-ARITH4": "add,sub,mul,div", "R-ELEM6": "add,sub,mul,div,exp,log",
+           "R-ELEM4": "add,mul,exp,log", "R-TRIG": "add,mul,sin,cos",
+           "R-SRB": "add,sub,mul,div,exp,log,sin,cos,sqrt,square"}
+
+ap = argparse.ArgumentParser()
+for name in ("--set", "--targets", "--target_id", "--targets_sha256"):
+    ap.add_argument(name, required=True)
+ap.add_argument("--config", choices=["symbolic", "default"], required=True)
+ap.add_argument("--budget", type=float, required=True, help="multiples of E0 = 2x10^4 evaluations")
+ap.add_argument("--seed", type=int, required=True)
+a = ap.parse_args()
+try:
+    check_search_allowed(a.set)
+except PermissionError as err:
+    sys.exit(f"refused: {err}")
+raw = open(a.targets, "rb").read()
+if hashlib.sha256(raw).hexdigest() != a.targets_sha256:
+    sys.exit("refused: target file checksum differs from the registered one")
+from pyoperon.sklearn import SymbolicRegressor   # noqa: E402  (after the checks: fail fast without Operon)
+
+g = G.get(a.set)
+tgt = next(t for t in json.loads(raw) if t["target_id"] == a.target_id)
+tree = G.parse_expr(tgt["expression"], g)
+rng = np.random.default_rng(a.seed)
+xtr = rng.uniform(2.0, 3.0, 75)
+ytr = G.evaluate(g, tree, xtr.astype(complex)).real
+grid = G.sample_grid(g)
+gv = np.array([complex(*z) for z in tgt["grid_values"]]) if "grid_values" in tgt else G.evaluate(g, tree, grid)
+kw = dict(allowed_symbols=SYMBOLS[a.set] + ",variable,constant", max_evaluations=int(a.budget * 20_000),
+          generations=100_000, random_state=a.seed, n_threads=1)
+kw.update(dict(symbolic_mode=True, objectives=["mse"]) if a.config == "symbolic" else dict(optimizer_iterations=10))
+t0, c0 = time.time(), time.process_time()
+m = SymbolicRegressor(**kw)
+m.fit(xtr.reshape(-1, 1), ytr)
+s = m.get_model_string(m.model_, 17)
+exact = is_exact(s, gv, tgt["target_scale"], grid.real)
+print("RESULT " + json.dumps(dict(
+    set=g.name, domain="real", algorithm="operon", config=a.config, seed=a.seed, target_id=tgt["target_id"],
+    K_proven=tgt.get("K_proven"), K_construction=tgt.get("K_construction"), units=tgt.get("units"),
+    budget=a.budget, budget_E=int(a.budget * 20_000), evaluations=int(m.stats_.get("evaluation_count", -1)),
+    residual_evaluations=int(m.stats_.get("residual_evaluations", -1)),          # with local search these, plus the
+    jacobian_evaluations=int(m.stats_.get("jacobian_evaluations", -1)),          # Jacobian ones, use max_evaluations
+    generations=int(m.stats_.get("generations", -1)), exact=bool(exact),
+    terminal_state="converged" if exact else "budget_exhausted", model=s[:2000],
+    cpu_seconds=time.process_time() - c0,
+    wall_seconds=time.time() - t0)),        # recorded only, never compared (CPU-time rule)
+    flush=True)
diff --git a/src/reach/tasks/s2_operon_score.py b/src/reach/tasks/s2_operon_score.py
new file mode 100644
index 0000000000000000000000000000000000000000..caca98422bc604fc07bb3d63ed5b8d317f6d82f1
--- /dev/null
+++ b/src/reach/tasks/s2_operon_score.py
@@ -0,0 +1,45 @@
+"""Operon scoring in double precision (D056; tool T20). Pure numpy: imported by the Operon task (.venv-ext) and by tests.
+
+Operon predicts in float32 and appends a fitted scale and intercept, so its raw predictions never match a target to 9
+digits. A model is scored exact when its expression (printed with 17 digits) re-evaluated in double precision, with
+the scale and intercept refitted by least squares in double, hashes like the target with the target's scale."""
+import hashlib
+
+import numpy as np
+
+_FUN = {"exp": np.exp, "log": np.log, "sin": np.sin, "cos": np.cos, "sqrt": np.sqrt, "square": np.square,
+        "abs": np.abs}
+
+
+def evaluate_model(s, x):
+    """Evaluate an Operon infix string on x (float64 array) with numpy; X1 is the variable; ^ is a power."""
+    ns = dict(_FUN, X1=np.asarray(x, float), __builtins__={})
+    with np.errstate(all="ignore"):
+        try:
+            return np.asarray(eval(s.replace("^", "**"), ns), float) * np.ones(len(x))    # noqa: S307 (trusted output)
+        except (ZeroDivisionError, OverflowError, ValueError):
+            return np.full(len(x), np.nan)        # plain-Python constant arithmetic failed: undefined, not exact (row 74)
+
+
+def scaled_hash(vec, scale, precision=9):
+    """Identical to reach.grammar.scaled_func_hash (tested)."""
+    with np.errstate(all="ignore"):
+        v = np.asarray(vec, dtype=np.complex128) / scale
+        r, i = np.round(v.real, precision) + 0.0, np.round(v.imag, precision) + 0.0
+        r[~np.isfinite(r)] = np.nan
+        i[~np.isfinite(i)] = np.nan
+    return hashlib.sha1(r.tobytes() + i.tobytes()).hexdigest()
+
+
+def is_exact(model_str, target, scale, x=None):
+    """target: complex values on the grid (x defaults to the 100-point grid on (2, 3))."""
+    if x is None:
+        x = np.array([2.0 + (i + 1) / 101 for i in range(100)])
+    h = evaluate_model(model_str, x)
+    t = np.asarray(target, complex)
+    # complex only if the imaginary part survives the hash's rounding (float noise of 1e-16 does not; review 2, row 66)
+    if not np.isfinite(h).all() or np.any(np.round(t.imag / scale, 9) != 0):
+        return False
+    A = np.column_stack([np.ones_like(h), h])
+    coef, *_ = np.linalg.lstsq(A, t.real, rcond=None)
+    return scaled_hash(A @ coef, scale) == scaled_hash(t, scale)
diff --git a/src/reach/tasks/s2_opprobe.py b/src/reach/tasks/s2_opprobe.py
new file mode 100644
index 0000000000000000000000000000000000000000..053a4e67e7f1062579e0acac9ff3496546c76e92
--- /dev/null
+++ b/src/reach/tasks/s2_opprobe.py
@@ -0,0 +1,125 @@
+"""Operator probe (tool T13; lesson 20; REQ-RULE-08): does every variation operator do what it claims?
+
+For each set, parents are drawn like GP's initial population and each operator is applied once per event. Recorded per
+operator: the share of events whose child computes a different function from the parent (grid hash or truth table), the
+mean size change, and the share rejected by the depth or node cap (the child is then a copy of the parent). An operator
+whose changed share, among accepted events with a defined parent (two undefined trees hash alike), is below FLAG_BELOW
+is flagged as a near no-op (EML-GP's semantic crossover changed nothing in 99%
+of events). The changed share among events not blocked by a cap is reported too.
+
+    python -m reach.tasks.s2_opprobe [--sets ...] [--n 2000]      -> RESULT line per set; docs/status gets the table
+"""
+import argparse
+import json
+import math
+import random
+
+import numpy as np
+
+from reach import grammar as G
+from reach.engines.treegp import MAX_DEPTH, _patch
+from reach.galib.evolution import crossover, mutate
+from reach.galib.generator import generate_random_tree
+
+FLAG_BELOW = 0.10          # a near no-op (EML-GP's semantic crossover changed <= 3% of events); neutrality above
+                           # this is a property of the set (small Boolean spaces are highly neutral), not a defect
+
+
+def _random_tree(g, rng):
+    return generate_random_tree(rng.randint(2, MAX_DEPTH), g.operators, list(g.constants), list(g.variables),
+                                rng.choice(["full", "grow"]))
+
+
+def operators(g):
+    mut_depth = max(2, round(math.sqrt(MAX_DEPTH)))
+    cons, vars_ = list(g.constants), list(g.variables)
+    return {
+        "subtree_mutation": lambda t, rng: mutate(t, g.operators, cons, vars_, mut_depth, absolute_max_depth=MAX_DEPTH),
+        "subtree_crossover": lambda t, rng: crossover(t, _random_tree(g, rng), max_depth=MAX_DEPTH)[0],
+        "headless_crossover": lambda t, rng: crossover(t, _random_tree(g, rng), max_depth=MAX_DEPTH)[0],
+    }
+
+
+def _sem(g, t):
+    if G.count_nodes(t) > G.MAX_NODES:
+        return None
+    if g.kind == "bool":
+        return G.evaluate(g, t)
+    v = G.evaluate(g, t, G.sample_grid(g))
+    return G.scaled_func_hash(v, max(1.0, float(np.nanmax(np.abs(np.where(np.isfinite(v), v, 0))))))
+
+
+def _defined(g, t):
+    """Real: finite everywhere on the grid; Boolean: always."""
+    if g.kind == "bool":
+        return True
+    return G.count_nodes(t) <= G.MAX_NODES and bool(np.isfinite(G.evaluate(g, t, G.sample_grid(g))).all())
+
+
+def probe(g, ops, n=2000, seed=1):
+    rng = random.Random(seed)
+    _patch(rng)                                     # ga-lib draws from the global random module
+    out = {}
+    for name, op in ops.items():
+        changed = rejected = defined = changed_def = accepted_def = 0
+        dsize = []
+        for _ in range(n):
+            parent = _random_tree(g, rng)
+            child = op(parent, rng)
+            same_tree = G.expr_str(child) == G.expr_str(parent)
+            rejected += same_tree
+            ch = _sem(g, child) != _sem(g, parent)
+            changed += ch
+            if _defined(g, parent):
+                defined += 1
+                if not same_tree:
+                    accepted_def += 1
+                    changed_def += ch
+            dsize.append(G.count_nodes(child) - G.count_nodes(parent))
+        out[name] = dict(events=n, changed_share=changed / n, rejected_share=rejected / n,
+                         changed_share_accepted=changed / max(n - rejected, 1),
+                         defined_parent_share=defined / n,
+                         changed_share_defined=changed_def / max(accepted_def, 1),
+                         size_change_mean=float(np.mean(dsize)), size_change_sd=float(np.std(dsize)),
+                         flag=(accepted_def >= 50 and changed_def / accepted_def < FLAG_BELOW)
+                         or (changed / n < FLAG_BELOW and rejected / n > 0.5),       # returns the parent: a no-op
+                         few_defined=accepted_def < 50)
+    return out
+
+
+def merge_results(path, new):
+    """Add or replace the given sets in the probe file, keeping every other set's values."""
+    old = json.loads(path.read_text()) if path.exists() else {}
+    old.update(new)
+    path.write_text(json.dumps(old, indent=1))
+    return old
+
+
+def main():
+    """Sets -> merged into data/analysis/opprobe.json; docs/status/opprobe_report.md lists every probed set."""
+    from reach import s2_sets as S
+    from reach.paths import ROOT
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--sets", nargs="*", default=list(S.SETS))
+    ap.add_argument("--n", type=int, default=2000)
+    ap.add_argument("--seed", type=int, default=20261020)
+    a = ap.parse_args()
+    (ROOT / "data/analysis").mkdir(parents=True, exist_ok=True)
+    res = merge_results(ROOT / "data/analysis/opprobe.json",
+                        {s: probe(G.get(s), operators(G.get(s)), a.n, a.seed) for s in a.sets})
+    L = ["# Operator probe (T13; lesson 20)", "", "> Index: `docs/README.md`. Generated by `reach.tasks.s2_opprobe`; values "
+         "in `data/analysis/opprobe.json`. Parents drawn like GP's initial population; n events per operator.", "",
+         "| Set | defined parents | changed (defined parents): mutation / crossover / headless | blocked by a cap | flags |",
+         "|---|---|---|---|---|"]
+    for s, r in res.items():
+        m, c, h = r["subtree_mutation"], r["subtree_crossover"], r["headless_crossover"]
+        flags = [k for k, v in r.items() if v["flag"]] or (["few defined parents"] if any(v["few_defined"] for v in r.values()) else [])
+        L.append(f"| {s} | {m['defined_parent_share']:.2f} | {m['changed_share_defined']:.2f} / {c['changed_share_defined']:.2f} / "
+                 f"{h['changed_share_defined']:.2f} | {m['rejected_share']:.2f} / {c['rejected_share']:.2f} / "
+                 f"{h['rejected_share']:.2f} | {', '.join(flags) or 'none'} |")
+    (ROOT / "docs/status/opprobe_report.md").write_text("\n".join(L) + "\n")
+    print("\n".join(L))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/reach/tasks/s2_pool.py b/src/reach/tasks/s2_pool.py
new file mode 100644
index 0000000000000000000000000000000000000000..4d9d0dbe4ed6d1c0ce01b9845bd685a27ccf9813
--- /dev/null
+++ b/src/reach/tasks/s2_pool.py
@@ -0,0 +1,201 @@
+"""Shared-function pool for H3 (tool T12; docs/design/targets.md, set T2; REQ-MEA-15).
+
+Join the enumeration keys of the calibration sets of one domain (real keys are comparable: same grid, same key function;
+Boolean keys are truth tables). A function enters the pool if its minimum size is proven in at least `min_sets` sets
+(Boolean 4, real 3). Functions are sampled stratified by their size spread across sets (max - min minimum size), so that
+H3 sees functions whose shortest construction differs a lot between sets. Each pool function gets one pool_id and,
+in every set where it is proven, that set's shallowest minimal tree (C5; depth <= 10 required). Real per-tree filters
+(complex, floating point, dead subtree; near duplicates when values are given) are applied per set; a function that
+drops below `min_sets` after filtering is removed. Held-out sets are never included (C1).
+
+    python -m reach.tasks.s2_pool --domain bool --n 40 --seed 20261023     -> data/targets_s2/<set>/pool.json (+ sha256)
+"""
+import argparse
+import json
+import random
+from collections import defaultdict
+
+import numpy as np
+
+from reach import grammar as G
+from reach.enumerate import read_level
+from reach.s2_targets import DEPTH_LIMIT, boolean_properties, real_filters, write_frozen
+from reach.targets import load_structure
+
+
+def _levels(d):
+    stats = json.loads((d / "counts.json").read_text())["levels"]
+    return {st["K"]: read_level(d / f"level_{st['K']:03d}.npz")[0] for st in stats if st["U"] > 0}
+
+
+def join_sizes(dirs, min_sets=1, candidates=None):
+    """{key: {set: minimum size}} for functions in at least `min_sets` sets. Without `candidates`: a vectorised join of
+    all keys (real sets); with `candidates` (uint64 keys): look only those up in every set (Boolean sets at n = 5)."""
+    out = defaultdict(dict)
+    if candidates is not None:
+        cand = np.unique(np.asarray(candidates, dtype=np.uint64))
+        for s, d in dirs.items():
+            for K, keys in _levels(d).items():
+                for k in cand[np.isin(cand, keys)].tolist():
+                    out[k][s] = K
+        return {k: v for k, v in out.items() if len(v) >= min_sets}
+    ks, ss, ls = [], [], []
+    names = sorted(dirs)
+    for si, s in enumerate(names):
+        for K, keys in _levels(dirs[s]).items():
+            ks.append(keys)
+            ss.append(np.full(len(keys), si, np.int16))
+            ls.append(np.full(len(keys), K, np.int16))
+    k, s_, l_ = np.concatenate(ks), np.concatenate(ss), np.concatenate(ls)
+    order = np.argsort(k, kind="stable")
+    k, s_, l_ = k[order], s_[order], l_[order]
+    uk, start, cnt = np.unique(k, return_index=True, return_counts=True)
+    for key, a, c in zip(uk[cnt >= min_sets].tolist(), start[cnt >= min_sets], cnt[cnt >= min_sets]):
+        for j in range(a, a + c):
+            out[key][names[s_[j]]] = int(l_[j])
+    return dict(out)
+
+
+def _spread_bin(spread):
+    return 0 if spread == 0 else 1 if spread <= 2 else 2 if spread <= 4 else 3 if spread <= 8 else 4
+
+
+def _anchor_candidates(d, n_cand, rng):
+    """Keys sampled from the anchor, spread evenly over its non-trivial levels (Boolean path)."""
+    lv = {K: keys for K, keys in _levels(d).items() if K >= 2}
+    per = max(1, n_cand // len(lv))
+    out = []
+    for K in sorted(lv):
+        keys = lv[K]
+        idx = rng.sample(range(len(keys)), min(per, len(keys)))
+        out += [int(keys[i]) for i in idx]
+    return out
+
+
+def _find(e, key):
+    for K in sorted(e.keys):
+        hit = np.nonzero(e.keys[K] == np.uint64(key))[0]
+        if len(hit):
+            return K, int(hit[0])
+    return None
+
+
+N_BINS = 5
+
+
+def _select(bins, evaluate, n):
+    """Equal quotas per spread bin, binned AFTER the per-set filters (guardrail row 51: filters remove most real
+    functions with a spread, so binning before them filled the pool with spread-0 functions, which carry no
+    within-function information). bins: {pre-filter bin: keys in random order}; evaluate(key) -> (recs, spread) or
+    None. Filters only drop sets, so a function's spread can only shrink: a pre-filter bin is skipped once every bin up
+    to it is full. A shortfall is filled with the passing functions left over, largest spread first."""
+    quota = {b: n // N_BINS + (1 if b >= N_BINS - n % N_BINS else 0) for b in range(N_BINS)}
+    chosen, spare = {b: [] for b in range(N_BINS)}, []
+    queues = {b: list(v) for b, v in bins.items()}
+    full = lambda b: all(len(chosen[p]) >= quota[p] for p in range(b + 1))         # noqa: E731
+    while sum(len(c) for c in chosen.values()) < n and any(queues[b] and not full(b) for b in queues):
+        for b in sorted(queues):
+            if not queues[b] or full(b):
+                continue
+            key = queues[b].pop(0)
+            r = evaluate(key)
+            if r is None:
+                continue
+            pb = _spread_bin(r[1])
+            (chosen[pb] if len(chosen[pb]) < quota[pb] else spare).append((key, r[0], r[1]))
+    need = n - sum(len(c) for c in chosen.values())
+    for b in sorted(queues, reverse=True):                    # shortfall: draw on, largest spread bins first
+        while need > len(spare) and queues[b]:
+            key = queues[b].pop(0)
+            r = evaluate(key)
+            if r is not None:
+                spare.append((key, r[0], r[1]))
+    out = [x for b in range(N_BINS) for x in chosen[b]]
+    out += sorted(spare, key=lambda x: -x[2])[:max(0, n - len(out))]
+    return out[:n]
+
+
+def build_pool(dirs, min_sets, n, seed, vals=None, anchor=None, n_cand=4000):
+    rng = random.Random(seed)
+    if anchor is not None:
+        sizes = join_sizes(dirs, min_sets, candidates=_anchor_candidates(dirs[anchor], n_cand, rng))
+    else:
+        sizes = join_sizes(dirs, min_sets)
+    sizes = {k: v for k, v in sizes.items() if min(v.values()) >= 2}
+    bins = defaultdict(list)
+    for k, v in sizes.items():
+        bins[_spread_bin(max(v.values()) - min(v.values()))].append(k)
+    for b in bins.values():
+        b.sort()
+        rng.shuffle(b)
+    structs = {s: load_structure(G.get(s), d) for s, d in dirs.items()}
+
+    def evaluate(key):
+        recs = {}
+        for s in sizes[key]:
+            g, e = G.get(s), structs[s]
+            K_, i = _find(e, key)
+            if e.depth[K_][i] > DEPTH_LIMIT:
+                continue
+            tree = G.parse_expr(e.expr(K_, i), g)
+            rec = dict(expression=G.expr_str(tree), K_construction=K_, K_proven=K_, constructed=False,
+                       depth=int(e.depth[K_][i]))
+            if g.kind == "real":
+                fields, why = real_filters(g, tree, K_, (vals or {}).get(s))
+                if fields is None:
+                    continue
+                rec.update(fields)
+            else:
+                rec["properties"] = boolean_properties(G.evaluate(g, tree), g.n_inputs)
+            recs[s] = rec
+        if len(recs) < min_sets:
+            return None
+        return recs, max(r["K_proven"] for r in recs.values()) - min(r["K_proven"] for r in recs.values())
+
+    pool = defaultdict(list)
+    for j, (key, recs, spread) in enumerate(_select(bins, evaluate, n)):
+        pid = f"pool{j:03d}"
+        for s, r in recs.items():
+            r.update(pool_id=pid, target_id=f"{s}_{pid}", size_spread=spread, n_sets=len(recs))
+            pool[s].append(r)
+    return dict(pool)
+
+
+def pool_sets(domain):
+    """The full calibration sets of a domain: exactly the sets that s2_cal_pool runs (guardrail row 49)."""
+    from reach.runner.phases import FULL_SETS
+    return [g for g in FULL_SETS if G.get(g).kind == domain]
+
+
+def main():
+    from reach.analysis.s2.phase1 import enum_dir, inflation_from
+    from reach.paths import ROOT
+    from reach.units import SizeUnits
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--domain", choices=["real", "bool"], required=True)
+    ap.add_argument("--n", type=int, required=True)
+    ap.add_argument("--seed", type=int, required=True)
+    a = ap.parse_args()
+    sets = pool_sets(a.domain)
+    dirs = {g: enum_dir(g) for g in sets}
+    vals, noise = None, {}
+    if a.domain == "real":                                     # near duplicates need each set's values
+        from reach.enumerate import Enumerator
+        vals = {}
+        for g in sets:
+            e = Enumerator(G.get(g), dirs[g], log=lambda *_: None)
+            e.load()
+            vals[g], noise[g] = e.vals, inflation_from(e)     # D050 noise rows: bits_sem as in calibration targets
+    pool = build_pool(dirs, 3 if a.domain == "real" else 4, a.n, a.seed, vals,
+                      anchor="BOOL-NAND-n5" if a.domain == "bool" else None)
+    for g, ts in pool.items():
+        su = SizeUnits(G.get(g), json.loads((dirs[g] / "counts.json").read_text())["levels"], noise_rows=noise.get(g))
+        for t in ts:
+            t["units"] = su.all(t["K_proven"])
+        write_frozen(ROOT / "data/targets_s2" / g, "pool", ts, dict(domain=a.domain, seed=a.seed, n=a.n, sets=sets))
+    print("RESULT " + json.dumps(dict(domain=a.domain, terminal_state="completed", functions=len({t["pool_id"] for ts in
+                                      pool.values() for t in ts}), sets={g: len(ts) for g, ts in pool.items()})), flush=True)
+
+
+if __name__ == "__main__":
+    main()
